<!-- Research tree: data lives in _data/research_tree.yml, rendering in assets/js/research_tree.js -->
<div id="research-tree" class="research-tree">
  <p class="rt-credit">Inspired by Philippe Laban's <a href="https://tingofurro.github.io/" target="_blank" rel="noopener">research garden</a>.</p>
  <div class="rt-legend" aria-hidden="true"></div>
  <div class="rt-scroll"></div>
  <div class="rt-scroll-hint">← scroll to explore →</div>
  <div class="rt-panel" aria-live="polite">
    <p class="rt-blurb">
      Each branch is a research thread, and every branch grows toward the same sun (goal). Leaves and fruit are papers. Vines show where one project
      builds on another, with sap flowing from the earlier work into the work it made possible. Hover or tap a paper to see it, or a branch name to
      see the whole thread.
    </p>
  </div>
</div>
<script type="application/json" id="research-tree-data">
  {{ site.data.research_tree | jsonify }}
</script>
<script defer src="{{ '/assets/js/research_tree.js' | relative_url | bust_file_cache }}"></script>
